# CATATAN: docker-compose.yml juga butuh file `.env` di folder yang sama berisi
# MYSQL_ROOT_PASSWORD, MYSQL_USER, MYSQL_PASSWORD. File itu juga tidak ikut git.
# Salin ke .env.docker lalu isi. File .env.docker TIDAK ikut git (berisi rahasia).
# APP_KEY: jalankan `php artisan key:generate --show`
# DB_USERNAME/DB_PASSWORD harus sama dengan MYSQL_USER/MYSQL_PASSWORD di docker-compose.yml

APP_NAME=
APP_ENV=
APP_KEY=
APP_DEBUG=
APP_URL=

LOG_CHANNEL=
LOG_LEVEL=

# DB pakai container `db`
DB_CONNECTION=
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Cache/queue/session aman default
BROADCAST_DRIVER=
CACHE_DRIVER=
FILESYSTEM_DISK=
QUEUE_CONNECTION=
SESSION_DRIVER=
SESSION_LIFETIME=

# ---- Cookie session: WAJIB diisi di PRODUKSI ----
# Form booking disematkan lewat iframe di syamsululum.telkomuniversity.ac.id.
# Dengan SameSite=lax (bawaan Laravel) browser TIDAK mengirim cookie session di
# dalam iframe lintas domain, sehingga tiap POST kehilangan session dan dibalas
# 419 "This page has expired" - upload dan pengajuan gagal total.
#   SESSION_SAME_SITE=none          izinkan cookie di konteks pihak ketiga
#   SESSION_SECURE_COOKIE=true      wajib menyertai SameSite=None; butuh HTTPS
#   SESSION_PARTITIONED_COOKIE=true CHIPS; Chrome memblokir cookie pihak ketiga
#                                   biasa (selalu di Incognito)
# JANGAN dipakai saat development di http://localhost - SESSION_SECURE_COOKIE=true
# membuat browser membuang cookie karena bukan HTTPS. Kosongkan ketiganya di lokal.
SESSION_SAME_SITE=
SESSION_SECURE_COOKIE=
SESSION_PARTITIONED_COOKIE=

# Vite (dev)
VITE_HOST=
VITE_PORT=

# Mailtrap Config
MAIL_MAILER=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

MAIL_ADMIN_ADDRESS=
